# PMXT Router API key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Create one at https://pmxt.dev/dashboard (starts with pmxt_live_).
PMXT_API_KEY=pmxt_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the PMXT API base URL (defaults to https://api.pmxt.dev).
# Also used by the /api/pmxt catalog proxy that backs the PMXT widgets.
# PMXT_API_BASE=https://api.pmxt.dev

# Optional: override the PMXT trading API base URL (defaults to https://trade.pmxt.dev).
# Used by the /api/trade proxy that backs the widgets' non-custodial trade flow.
# Trading is bring-your-own-key: the proxy forwards the user's own Authorization
# header and never falls back to the server key.
# TRADING_API_URL=https://trade.pmxt.dev
