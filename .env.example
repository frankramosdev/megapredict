# PMXT Router API key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Create one at https://pmxt.dev/dashboard (starts with pmxt_live_).
PMXT_API_KEY=pmxt_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the PMXT API base URL (defaults to https://api.pmxt.dev).
# PMXT_API_BASE=https://api.pmxt.dev
